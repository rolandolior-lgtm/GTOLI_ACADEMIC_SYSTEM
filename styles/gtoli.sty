%================================================
% EN-TÊTE ET PIED DE PAGE
%================================================
\newcommand{\uaaentete}{UAA}
\newcommand{\titreentete}{Titre du chapitre}
\newcommand{\anneescolaire}{Année scolaire 2025--2026}

\newcommand{\ReglageEntete}[3]{%
\renewcommand{\uaaentete}{#1}
\renewcommand{\titreentete}{#2}
\renewcommand{\anneescolaire}{#3}
}

\pagestyle{fancy}
\fancyhf{}

\lhead{\small\textbf{\uaaentete}}
\rhead{\small\textbf{\titreentete}}

\lfoot{\small \anneescolaire}
\rfoot{\small Page \thepage}

\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}

%================================================
% RÉGLAGES GÉNÉRAUX
%================================================
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.45em}

\setlist[itemize]{topsep=2pt,itemsep=2pt,parsep=0pt}
\setlist[enumerate]{topsep=2pt,itemsep=2pt,parsep=0pt}

\renewcommand{\arraystretch}{1.25}

%================================================
% CADRES PÉDAGOGIQUES
%================================================
\tcbset{
  enhanced,
  breakable,
  sharp corners=downhill,
  arc=2mm,
  boxrule=0.8pt,
  left=1.5mm,
  right=1.5mm,
  top=1mm,
  bottom=1mm,
  fonttitle=\bfseries
}

\newtcolorbox{cadrebleu}[1]{
  colback=bleuclair,
  colframe=bleufonce,
  title=#1
}

\newtcolorbox{cadrevert}[1]{
  colback=vertclair,
  colframe=vertfonce,
  title=#1
}

\newtcolorbox{cadreorange}[1]{
  colback=orangeclair,
  colframe=orangefonce,
  title=#1
}

\newtcolorbox{cadrerouge}[1]{
  colback=rougeclair,
  colframe=rougefonce,
  title=#1
}

\newtcolorbox{cadregris}[1]{
  colback=grisclair,
  colframe=grisfonce,
  title=#1
}

%================================================
% CADRES AVEC TITRE FIXE
%================================================
\newtcolorbox{cadreobjectif}{
  colback=bleuclair,
  colframe=bleufonce,
  title=Objectifs
}

\newtcolorbox{cadretheorie}{
  colback=rougeclair,
  colframe=rougefonce,
  title=Rappel théorique
}

\newtcolorbox{cadremethode}{
  colback=vertclair,
  colframe=vertfonce,
  title=Méthode / Protocole
}

\newtcolorbox{cadreexemple}{
  colback=grisclair,
  colframe=grisfonce,
  title=Exemple
}

\newtcolorbox{cadreenonce}{
  colback=white,
  colframe=black,
  title=Énoncé
}

\newtcolorbox{cadreaide}{
  colback=orangeclair,
  colframe=orangefonce,
  title=Aide / Piste
}

\newtcolorbox{cadresolution}{
  colback=bleuclair,
  colframe=bleufonce,
  title=Solution détaillée
}

\newtcolorbox{cadresynthese}{
  colback=bleuclair,
  colframe=bleufonce,
  title=Synthèse
}

\newtcolorbox{cadreattention}{
  colback=rougeclair,
  colframe=rougefonce,
  title=Attention
}

\newtcolorbox{cadreactivite}{
  colback=vertclair,
  colframe=vertfonce,
