}

%================================================
% TEXTE NON ENCADRÉ
%================================================
\newenvironment{texteimportant}
{\par\medskip\noindent\textbf{Point important.}\ }
{\par\medskip}

\newenvironment{developpement}
{\par\medskip}
{\par\medskip}

%================================================
% TABLEAUX LARGES
%================================================
\newenvironment{tableaularge}[1]
{
\begin{center}
\small
\renewcommand{\arraystretch}{1.25}
\begin{tabularx}{\textwidth}{#1}
}
{
\end{tabularx}
\end{center}
}

%================================================
% TABLEAUX LONGS AUTOMATIQUES MULTIPAGES
%================================================
\newenvironment{tableausolutionlong}[1]
{
\small
\renewcommand{\arraystretch}{1.25}
\begin{longtable}{#1}
}
{
\end{longtable}
\normalsize
}

