%================================================
\geometry{
  a4paper,
  left=1.15cm,
  right=1.15cm,
  top=1.25cm,
  bottom=1.45cm,
  headheight=14pt,
  headsep=0.20cm,
  footskip=0.75cm
}

%================================================
% COULEURS
%================================================
\definecolor{bleuclair}{RGB}{225,240,255}
\definecolor{vertclair}{RGB}{225,245,225}
\definecolor{orangeclair}{RGB}{255,238,210}
\definecolor{rougeclair}{RGB}{255,225,225}
\definecolor{grisclair}{RGB}{245,245,245}
\definecolor{jauneclair}{RGB}{255,250,210}

\definecolor{bleufonce}{RGB}{20,70,140}
\definecolor{vertfonce}{RGB}{30,120,70}
\definecolor{orangefonce}{RGB}{190,100,20}
\definecolor{rougefonce}{RGB}{160,40,40}
\definecolor{grisfonce}{RGB}{70,70,70}

